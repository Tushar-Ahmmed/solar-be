generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  COMMERCIAL
  INDUSTRIAL
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  OUT_OF_STOCK
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  ORDER_DEDUCTION
  INSTALLATION_USAGE
  RETURN
}

enum SolarPackageStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  DELIVERED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION_SENT
  WON
  LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ServiceRequestType {
  INSTALLATION
  REPAIR
  MAINTENANCE
  INSPECTION
  CONSULTATION
}

enum ServiceRequestStatus {
  PENDING
  REVIEWING
  QUOTATION_REQUIRED
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InstallationStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  SITE_SURVEY
  QUOTATION
  CUSTOMER_APPROVAL
  PROCUREMENT
  INSTALLATION
  TESTING
  HANDOVER
  MAINTENANCE
  COMPLETED
  CANCELLED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SystemSettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                  UserRole[]
  authSessions            AuthSession[]
  refreshTokens          RefreshToken[]
  customerProfile        CustomerProfile?
  notifications          Notification[]
  inventoryTransactions  InventoryTransaction[] @relation("inventoryTransactionCreatedBy")
  createdQuotes          Quote[]                @relation("quoteCreatedBy")
  changedQuoteStatus     QuoteStatusHistory[]   @relation("quoteStatusChangedBy")
  authoredBlogPosts      BlogPost[]             @relation("blogAuthor")
  handledContactRequests ContactRequest[]       @relation("contactHandledBy")
  updatedSystemSettings  SystemSetting[]        @relation("systemSettingUpdatedBy")

  @@index([email])
  @@index([phone])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model CustomerProfile {
  id           String       @id @default(uuid())
  userId       String       @unique
  companyName  String?
  customerType CustomerType @default(INDIVIDUAL)
  designation  String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses         Address[]
  orders            Order[]
  leads             Lead[]
  quotes            Quote[]
  requests          ServiceRequest[]
  installations     Installation[]
  projects          Project[]
  warranties        Warranty[]
  reviews           Review[]
  solarCalculations SolarCalculation[]
}

model Address {
  id            String   @id @default(uuid())
  customerId    String
  label         String
  recipientName String
  phone         String?
  addressLine   String
  divisionId    String
  districtId    String
  upazilaId     String
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer        CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  division        Division         @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  district        District         @relation(fields: [districtId], references: [id], onDelete: Restrict)
  upazila         Upazila          @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  orders          Order[]
  serviceRequests ServiceRequest[]
  installations   Installation[]
  projectSiteFor  Project[]        @relation("projectSiteAddress")

  @@index([customerId])
  @@index([divisionId])
  @@index([districtId])
  @@index([upazilaId])
}

model Division {
  id        String   @id @default(uuid())
  name      String   @unique
  bnName    String?
  code      String   @unique
  createdAt DateTime @default(now())

  districts District[]
  addresses Address[]
  leads     Lead[]     @relation("leadDivision")
}

model District {
  id         String   @id @default(uuid())
  divisionId String
  name       String
  bnName     String?
  code       String
  createdAt  DateTime @default(now())

  division  Division  @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  upazilas  Upazila[]
  addresses Address[]
  leads     Lead[]    @relation("leadDistrict")

  @@unique([divisionId, code])
  @@index([divisionId])
}

model Upazila {
  id         String   @id @default(uuid())
  districtId String
  name       String
  bnName     String?
  code       String
  createdAt  DateTime @default(now())

  district  District  @relation(fields: [districtId], references: [id], onDelete: Restrict)
  addresses Address[]
  leads     Lead[]    @relation("leadUpazila")

  @@unique([districtId, code])
  @@index([districtId])
}

model Category {
  id          String         @id @default(uuid())
  parentId    String?
  name        String
  slug        String         @unique
  description String?
  imageUrl    String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToParent")
  products Product[]

  @@index([parentId])
  @@index([status])
  @@index([slug])
}

model Brand {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  description String?
  logoUrl     String?
  status      BrandStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products Product[]
}

model Product {
  id                   String        @id @default(uuid())
  categoryId           String
  brandId              String
  name                 String
  slug                 String        @unique
  sku                  String        @unique
  shortDescription     String?
  description          String?
  price                Decimal       @db.Decimal(12, 2)
  salePrice            Decimal?      @db.Decimal(12, 2)
  minimumOrderQuantity Int           @default(1)
  warrantyPeriod       Int?
  status               ProductStatus @default(ACTIVE)
  featured             Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                 Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  inventory             Inventory?
  images                ProductImage[]
  specifications        ProductSpecification[]
  packageItems          SolarPackageItem[]
  orderItems            OrderItem[]
  quoteItems            QuoteItem[]
  installationItems     InstallationItem[]
  projectItems          ProjectItem[]
  warranties            Warranty[]
  reviews               Review[]
  inventoryTransactions InventoryTransaction[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([featured])
  @@index([slug])
  @@index([sku])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  objectKey String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpecification {
  id        String   @id @default(uuid())
  productId String
  name      String
  value     String
  unit      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Inventory {
  id               String   @id @default(uuid())
  productId        String   @unique
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  reorderLevel     Int      @default(0)
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
}

model InventoryTransaction {
  id            String                   @id @default(uuid())
  productId     String
  type          InventoryTransactionType
  quantity      Int
  referenceType String?
  referenceId   String?
  reason        String?
  createdById   String?
  createdAt     DateTime                 @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("inventoryTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@index([type])
}

model SolarPackage {
  id                   String             @id @default(uuid())
  name                 String
  slug                 String             @unique
  description          String?
  systemCapacityKw     Decimal            @db.Decimal(10, 2)
  price                Decimal            @db.Decimal(12, 2)
  salePrice            Decimal?           @db.Decimal(12, 2)
  installationIncluded Boolean            @default(false)
  status               SolarPackageStatus @default(ACTIVE)
  featured             Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  items         SolarPackageItem[]
  installations Installation[]
}

model SolarPackageItem {
  id        String  @id @default(uuid())
  packageId String
  productId String
  quantity  Int     @default(1)
  sortOrder Int     @default(0)
  notes     String?

  package SolarPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([packageId])
  @@index([productId])
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  customerId     String
  addressId      String?
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal     @default(0) @db.Decimal(12, 2)
  tax            Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  customerNote   String?
  adminNote      String?
  confirmedAt    DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address        Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  paymentRecords PaymentRecord[]
  warranties     Warranty[]
  reviews        Review[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Lead {
  id           String     @id @default(uuid())
  leadNumber   String     @unique
  customerId   String?
  name         String
  email        String?
  phone        String?
  divisionId   String?
  districtId   String?
  upazilaId    String?
  propertyType String?
  requirement  String?
  budget       Decimal?   @db.Decimal(12, 2)
  source       String?
  status       LeadStatus @default(NEW)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer    CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  division    Division?        @relation("leadDivision", fields: [divisionId], references: [id], onDelete: SetNull)
  district    District?        @relation("leadDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  upazila     Upazila?         @relation("leadUpazila", fields: [upazilaId], references: [id], onDelete: SetNull)
  attachments LeadAttachment[]
  quotes      Quote[]
  projects    Project[]

  @@index([leadNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model LeadAttachment {
  id        String   @id @default(uuid())
  leadId    String
  objectKey String
  url       String
  fileName  String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Quote {
  id                 String      @id @default(uuid())
  quoteNumber        String      @unique
  customerId         String
  leadId             String?
  status             QuoteStatus @default(DRAFT)
  subtotal           Decimal     @db.Decimal(12, 2)
  discount           Decimal     @default(0) @db.Decimal(12, 2)
  tax                Decimal     @default(0) @db.Decimal(12, 2)
  installationCharge Decimal     @default(0) @db.Decimal(12, 2)
  deliveryCharge     Decimal     @default(0) @db.Decimal(12, 2)
  total              Decimal     @db.Decimal(12, 2)
  notes              String?
  validUntil         DateTime?
  sentAt             DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  createdById        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  customer       CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead           Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy      User?                @relation("quoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items          QuoteItem[]
  statusHistory  QuoteStatusHistory[]
  paymentRecords PaymentRecord[]

  @@index([quoteNumber])
  @@index([customerId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model QuoteStatusHistory {
  id          String       @id @default(uuid())
  quoteId     String
  fromStatus  QuoteStatus?
  toStatus    QuoteStatus
  changedById String?
  note        String?
  createdAt   DateTime     @default(now())

  quote     Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  changedBy User? @relation("quoteStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
}

model ServiceRequest {
  id            String               @id @default(uuid())
  requestNumber String               @unique
  customerId    String
  addressId     String?
  type          ServiceRequestType
  status        ServiceRequestStatus @default(PENDING)
  subject       String
  description   String?
  preferredDate DateTime?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  customer    CustomerProfile            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address     Address?                   @relation(fields: [addressId], references: [id], onDelete: SetNull)
  attachments ServiceRequestAttachment[]

  @@index([requestNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model ServiceRequestAttachment {
  id               String   @id @default(uuid())
  serviceRequestId String
  objectKey        String
  url              String
  fileName         String
  mimeType         String?
  size             Int?
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

model Installation {
  id                 String             @id @default(uuid())
  installationNumber String             @unique
  customerId         String
  addressId          String?
  packageId          String?
  installationDate   DateTime?
  status             InstallationStatus @default(PENDING)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer   CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address    Address?            @relation(fields: [addressId], references: [id], onDelete: SetNull)
  package    SolarPackage?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  items      InstallationItem[]
  photos     InstallationPhoto[]
  warranties Warranty[]

  @@index([installationNumber])
  @@index([customerId])
  @@index([status])
}

model InstallationItem {
  id             String   @id @default(uuid())
  installationId String
  productId      String
  quantity       Int
  serialNumber   String?
  notes          String?
  createdAt      DateTime @default(now())

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model InstallationPhoto {
  id             String   @id @default(uuid())
  installationId String
  objectKey      String
  url            String
  caption        String?
  createdAt      DateTime @default(now())

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
}

model Project {
  id              String        @id @default(uuid())
  projectNumber   String        @unique
  customerId      String
  leadId          String?
  name            String
  description     String?
  capacityKw      Decimal?      @db.Decimal(10, 2)
  status          ProjectStatus @default(SITE_SURVEY)
  siteAddressId   String?
  estimatedValue  Decimal?      @db.Decimal(12, 2)
  startDate       DateTime?
  expectedEndDate DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  siteAddress Address?        @relation("projectSiteAddress", fields: [siteAddressId], references: [id], onDelete: SetNull)
  items       ProjectItem[]

  @@index([projectNumber])
  @@index([customerId])
  @@index([status])
}

model ProjectItem {
  id          String   @id @default(uuid())
  projectId   String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Warranty {
  id             String         @id @default(uuid())
  warrantyNumber String         @unique
  customerId     String
  productId      String
  orderId        String?
  installationId String?
  serialNumber   String?
  purchaseDate   DateTime?
  warrantyStart  DateTime?
  warrantyEnd    DateTime?
  status         WarrantyStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  installation Installation?   @relation(fields: [installationId], references: [id], onDelete: SetNull)
  claims       WarrantyClaim[]

  @@index([warrantyNumber])
  @@index([customerId])
  @@index([productId])
  @@index([serialNumber])
}

model WarrantyClaim {
  id          String    @id @default(uuid())
  claimNumber String    @unique
  warrantyId  String
  problem     String
  status      String    @default("NEW")
  resolution  String?
  adminNotes  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warranty    Warranty                  @relation(fields: [warrantyId], references: [id], onDelete: Restrict)
  attachments WarrantyClaimAttachment[]
}

model WarrantyClaimAttachment {
  id        String   @id @default(uuid())
  claimId   String
  objectKey String
  url       String
  fileName  String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  claim WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model Review {
  id         String       @id @default(uuid())
  customerId String
  productId  String
  orderId    String?
  rating     Int
  title      String?
  comment    String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  order    Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model PaymentRecord {
  id                   String        @id @default(uuid())
  orderId              String?
  quoteId              String?
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("BDT")
  method               String?
  status               PaymentStatus @default(PENDING)
  transactionReference String?
  provider             String?
  metadata             Json          @default("{}")
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
}

model BlogPost {
  id               String     @id @default(uuid())
  authorId         String
  title            String
  slug             String     @unique
  excerpt          String?
  content          String
  featuredImageUrl String?
  status           BlogStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  author User @relation("blogAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([publishedAt])
}

model ContactRequest {
  id          String               @id @default(uuid())
  name        String
  email       String?
  phone       String?
  subject     String?
  message     String
  status      ContactRequestStatus @default(NEW)
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  handledBy User? @relation("contactHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status])
}

model SystemSetting {
  id          String            @id @default(uuid())
  key         String            @unique
  value       String?
  type        SystemSettingType @default(STRING)
  description String?
  isPublic    Boolean           @default(false)
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  updatedBy User? @relation("systemSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([key])
}

model SolarCalculation {
  id                    String   @id @default(uuid())
  customerId            String?
  estimatedLoadKw       Decimal? @db.Decimal(10, 2)
  dailyEnergyKwh        Decimal? @db.Decimal(10, 2)
  recommendedCapacityKw Decimal? @db.Decimal(10, 2)
  estimatedPanelCount   Int?
  inputs                Json     @default("{}")
  result                Json     @default("{}")
  createdAt             DateTime @default(now())

  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}
